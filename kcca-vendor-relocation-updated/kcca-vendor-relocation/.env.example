# Copy to .env and adjust. docker-compose.yml reads these automatically.
# Never commit the real .env.

# Host port for the application.
APP_PORT=8080

# Database name and application user. These are created on first start.
KCCA_DB_NAME=kcca_vendor_relocation
KCCA_DB_USER=kcca
KCCA_DB_PASS=change-me-app-password
KCCA_DB_ROOT_PASS=change-me-root-password

# 1  = seed an empty database on start (safe to repeat)
# 0  = never touch the database
# force = drop and reseed on every start (destructive)
KCCA_AUTO_SEED=1

# 1 = show exception detail on the database-error page. Leave 0 in production.
KCCA_DEBUG=0
